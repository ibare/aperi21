{
  "name": "aperi21",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "pnpm --filter @aperi21/catalog dev",
    "build": "pnpm --filter @aperi21/catalog build",
    "build:all": "pnpm -r build",
    "preview": "pnpm --filter @aperi21/catalog preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "catalog:gen": "tsx scripts/gen-aperi21-catalog.mts",
    "release:check": "tsx scripts/release-check.mts",
    "catalog:topics": "tsx scripts/gen-topic-catalog.mts",
    "budget": "tsx scripts/bundle-budget.mts",
    "gen:capabilities": "tsx scripts/gen-capabilities.mts",
    "piece:report": "tsx scripts/piece-report.mts",
    "messages:gen": "tsx scripts/gen-messages.mts",
    "screen:gen": "tsx scripts/gen-screen-labels.mts",
    "concept:index": "tsx scripts/gen-concept-index.mts",
    "concept:audit": "tsx scripts/concept-audit.mts",
    "gap:ledger": "tsx scripts/gen-topic-gap-ledger.mts",
    "registry:gen": "tsx scripts/gen-bundle-registry.mts",
    "surface:gen": "tsx scripts/gen-declared-surface.mts",
    "pairs:gen": "tsx scripts/gen-operation-pairs.mts",
    "gen:all": "tsx scripts/gen-check.mts --write",
    "gen:check": "tsx scripts/gen-check.mts"
  },
  "devDependencies": {
    "@aperi21/bootstrap": "workspace:*",
    "@aperi21/host": "workspace:*",
    "tsx": "^4.22.4",
    "yaml": "^2.9.1",
    "@aperi21/authoring": "workspace:*"
  }
}
