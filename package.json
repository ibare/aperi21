{
  "name": "aperi21",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "pnpm --filter @aperi21/catalog dev",
    "build": "pnpm --filter @aperi21/catalog build",
    "build:all": "pnpm -r build",
    "preview": "pnpm --filter @aperi21/catalog preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "catalog:gen": "tsx scripts/gen-aperi21-catalog.mts"
  },
  "devDependencies": {
    "@aperi21/bootstrap": "workspace:*",
    "@aperi21/host": "workspace:*",
    "tsx": "^4.22.4"
  }
}
