{
  "name": "@aperi21/authoring",
  "version": "0.2.0",
  "type": "module",
  "description": "aperi21 개념(concept) authoring 메타데이터. 호스트 LLM 파이프라인이 글에 넣을 시각화를 고르고(definition 임베딩), 고른 시각화의 내용을 writer 에게 전달(briefing)하는 데 쓰는 단일 출처.",
  "license": "MIT",
  "author": "Mintae Kim <ibare77@gmail.com>",
  "homepage": "https://github.com/ibare/aperi21/tree/main/packages/authoring#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibare/aperi21.git",
    "directory": "packages/authoring"
  },
  "bugs": {
    "url": "https://github.com/ibare/aperi21/issues"
  },
  "keywords": [
    "aperi21",
    "authoring",
    "concept",
    "embedding",
    "llm"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
