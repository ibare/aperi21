{
  "name": "@aperi21/host-tiptap-bundle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Self-contained ESM bundle of @aperi21/host-tiptap + bundle-* + plugin-*. 외부 호스트 앱(예: 노트 에디터) 가 단일 의존으로 소비.",
  "main": "./dist/host-tiptap-bundle.js",
  "types": "./dist/host-tiptap-bundle.d.ts",
  "exports": {
    ".": {
      "types": "./dist/host-tiptap-bundle.d.ts",
      "import": "./dist/host-tiptap-bundle.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "build:analyze": "VISUALIZE=1 rollup -c rollup.config.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "pack": "pnpm pack",
    "build:pack": "pnpm clean && pnpm build && pnpm pack"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/pm": "^3.0.0"
  },
  "devDependencies": {
    "@aperi21/bootstrap": "workspace:*",
    "@aperi21/host": "workspace:*",
    "@aperi21/host-tiptap": "workspace:*",
    "@aperi21/schema": "workspace:*",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@tiptap/core": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "rollup": "^4.28.0",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-esbuild": "^6.1.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "typescript": "^5.6.3"
  }
}
