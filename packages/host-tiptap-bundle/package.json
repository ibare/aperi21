{
  "name": "@aperi21/host-tiptap-bundle",
  "version": "0.2.0",
  "type": "module",
  "description": "Tiptap 확장 번들 — @aperi21/host-tiptap + sim-* + plugin-* 를 담는다. 런타임(@aperi21/host)은 peer 로 두어 레지스트리를 단일 인스턴스로 공유한다.",
  "license": "MIT",
  "author": "Mintae Kim <ibare77@gmail.com>",
  "homepage": "https://github.com/ibare/aperi21/tree/main/packages/host-tiptap-bundle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibare/aperi21.git",
    "directory": "packages/host-tiptap-bundle"
  },
  "bugs": {
    "url": "https://github.com/ibare/aperi21/issues"
  },
  "keywords": [
    "tiptap",
    "tiptap-extension",
    "prosemirror",
    "interactive",
    "visualization",
    "simulation",
    "physics",
    "aperi21",
    "esm"
  ],
  "sideEffects": false,
  "main": "./dist/host-tiptap-bundle.js",
  "module": "./dist/host-tiptap-bundle.js",
  "types": "./dist/host-tiptap-bundle.d.ts",
  "exports": {
    ".": {
      "types": "./dist/host-tiptap-bundle.d.ts",
      "import": "./dist/host-tiptap-bundle.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm clean && rollup -c rollup.config.mjs",
    "build:analyze": "pnpm clean && VISUALIZE=1 rollup -c rollup.config.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "pack": "pnpm pack",
    "build:pack": "pnpm clean && pnpm build && pnpm pack",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@aperi21/host": "workspace:^",
    "@tiptap/core": "^3.0.0",
    "@tiptap/pm": "^3.0.0"
  },
  "devDependencies": {
    "@aperi21/bootstrap": "workspace:*",
    "@aperi21/host": "workspace:*",
    "@aperi21/host-tiptap": "workspace:*",
    "@aperi21/schema": "workspace:*",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@tiptap/core": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "rollup": "^4.28.0",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-esbuild": "^6.1.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "typescript": "^5.6.3"
  }
}
